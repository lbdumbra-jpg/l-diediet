{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LDieDiet world conditions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "logic": {
      "enum": [
        "AND",
        "OR"
      ],
      "default": "AND"
    },
    "biomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Biome IDs or #biome tags; any listed biome matches."
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "advancements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "All listed advancements must be earned."
    },
    "weather": {
      "enum": [
        "clear",
        "rain",
        "thunder"
      ]
    },
    "cold_sweat_state": {
      "enum": [
        "freezing",
        "cold",
        "normal",
        "hot",
        "overheating"
      ]
    },
    "season": {
      "enum": [
        "spring",
        "summer",
        "autumn",
        "winter"
      ]
    },
    "temperature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23999
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23999
        }
      },
      "description": "Inclusive game-day ticks. min>max wraps across midnight."
    },
    "custom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "description_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
