{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LDieDiet food stage profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "default": 0
    },
    "nbt": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "thresholds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "minimum_hunger_restored": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "hunger_multipliers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "saturation_multipliers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "chewing_multipliers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          }
        },
        "nutrient_multipliers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "allow_food_buffs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "boolean"
          }
        },
        "allowed_food_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "blocked_food_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
